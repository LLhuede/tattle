      "description": "Shorten endpoint accepts alias",
      "polarity": "must",
      "kind": "target.modify",
      "params": {
        "target_hint": "shorten"
      }
    },
    {
      "id": "alias-min",
      "description": "Alias at least 3 characters",
      "polarity": "must",
      "kind": "param.literal",
      "params": {
        "value": 3,
        "unit": "characters"
      }
    },
    {
      "id": "alias-max",
      "description": "Alias at most 20 characters",
      "polarity": "must",
      "kind": "param.literal",
      "params": {
        "value": 20,
        "unit": "characters"
      }
    },
    {
      "id": "code-6",
      "description": "Random codes stay 6 characters",
      "polarity": "must",
      "kind": "param.literal",
