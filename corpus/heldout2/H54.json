{
  "schema": 1,
  "id": "H54",
  "title": "Custom aliases",
  "category": "edit",
  "language": "ts",
  "stack": "TypeScript + Express + better-sqlite3",
  "base": {
    "from": "G3"
  },
  "first_batch": false,
  "turns": [
    "let people choose their own short code by passing an optional `alias` in the POST /api/shorten body. aliases have to be between 3 and 30 characters, letters and numbers only. 409 if its taken. leave generateCode exactly as it is"
  ],
  "expected_facts": [
    {
      "id": "custom-alias",
      "description": "Optional user-chosen alias",
      "polarity": "must",
      "kind": "feature",
      "params": {
        "value": "custom-alias"
      }
    },
    {
      "id": "shorten",
      "description": "Change POST /api/shorten",
      "polarity": "must",
      "kind": "target.modify",
      "params": {
        "target_hint": "shorten"
      }
    },
    {
      "id": "alias-min-3",
      "description": "Alias at least 3 characters",
      "polarity": "must",
      "kind": "param.literal",
      "params": {
        "value": 3,
        "unit": "characters"
      }
    },
    {
      "id": "alias-max-30",
      "description": "Alias at most 30 characters",
      "polarity": "must",
      "kind": "param.literal",
      "params": {
        "value": 30,
        "unit": "characters"
      }
    },
    {
      "id": "alias-charset",
      "description": "Alias letters and numbers only",
      "polarity": "must",
      "kind": "param.charset",
      "params": {
        "value": "alphanumeric"
      }
    },
    {
      "id": "generate-untouched",
      "description": "Leave generateCode unchanged",
      "polarity": "must_not",
      "kind": "target.unchanged",
      "params": {
        "target_hint": "generateCode"
      }
    }
  ],
  "couldnt_check": [],
  "traps": [],
  "notes": "heldout2 (constraint-focused)"
}
