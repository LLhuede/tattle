#!/bin/sh
# Runs the tattle binary built for this computer (plugin/dist/tattle-<os>-<arch>,
# with .exe on Windows).
#
# Called by the plugin's hooks and by the /tattle: commands. It must never fail a hook:
# when no binary fits this computer, hooks exit 0 quietly and other commands
# print one plain line.
#
# On Windows, Claude Code runs hook commands through Git Bash, which reports
# itself as MINGW*/MSYS*/CYGWIN*.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
os=$(uname -s | tr '[:upper:]' '[:lower:]')
ext=""
case "$os" in
  mingw*|msys*|cygwin*|windows*) os=windows; ext=".exe" ;;
esac
arch=$(uname -m)
case "$arch" in
  arm64|aarch64) arch=aarch64 ;;
  x86_64|amd64) arch=x86_64 ;;
esac
bin="$here/../dist/tattle-$os-$arch$ext"
[ -x "$bin" ] || bin="$here/../dist/tattle-$os-universal$ext"
# Windows on Arm runs x86_64 programs.
[ -x "$bin" ] || bin="$here/../dist/tattle-$os-x86_64$ext"
if [ ! -x "$bin" ]; then
  if [ "$1" = hook ]; then
    cat >/dev/null 2>&1
    exit 0
  fi
  echo "tattle isn't available for this computer yet ($os, $arch)."
  exit 0
fi
TATTLE_PLUGIN=1
export TATTLE_PLUGIN
exec "$bin" "$@"
