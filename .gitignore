# Checker capture data (prompts, snapshots, logs): never commit
.checker/

# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Rust build output
target/
target-*/

# Results: generated by running the test suite or reviews. Kept on disk, not
# in git (the suite itself — prompts, bases, labels — is).
harness/results/
fixtures/oracle/
fixtures/reviews/

# Recordings: never in git (user decision, 2026-10-26). Their labels are, in
# corpus/labels/. Big-test runs write to artifacts/.
fixtures/recorded/
artifacts/
